# ── Database (Supabase) ────────────────────────────────────────────
# Pooled connection for the app (PgBouncer port 6543 in cloud; 54322 locally)
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
# Direct connection for Prisma migrations (bypasses pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# ── Supabase API (server helpers, future auth) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<from `supabase start` output>"
SUPABASE_SERVICE_ROLE_KEY="<from `supabase start` output — SERVER ONLY, never NEXT_PUBLIC>"

# ── CMS (Sanity, DEC-016) ──────────────────────────────────────────
CMS_PROJECT_ID=""
CMS_DATASET="production"
CMS_READ_TOKEN=""            # viewer token for draft preview
CMS_WEBHOOK_SECRET=""        # verifies /api/revalidate signatures

# ── AI (Gemini, DEC-020 — server only) ─────────────────────────────
AI_PROVIDER="gemini"
AI_API_KEY=""                # never NEXT_PUBLIC; local dev uses mock unless set
AI_ENABLED="false"           # deterministic-only until golden set passes; Blue never calls Gemini even when true
AI_DAILY_COST_CAP_USD="5"

# ── Sessions & security ────────────────────────────────────────────
SESSION_COOKIE_SECRET=""     # 32+ random bytes: `openssl rand -hex 32`

# ── Lead routing (HubSpot, DEC-037) ────────────────────────────────
LEAD_WEBHOOK_URL=""          # HubSpot inbound webhook
LEAD_WEBHOOK_SECRET=""       # HMAC signing key for outbound payloads
LEAD_NOTIFY_EMAIL=""         # owner fallback notification address

# ── Analytics (GA4, DEC-038) ───────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""   # G-XXXXXXXX; paste when owner supplies ID
# First-party /api/events still strips free text before any GA4 hit
