{
  "name": "labdox-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node -e \"console.log('E2E stub — Playwright lands with Red/Blue journeys');\"",
    "lhci": "node -e \"console.log('Lighthouse CI stub');\"",
    "check:traceability": "tsx scripts/check-traceability.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "csv-parse": "^7.0.2",
    "framer-motion": "^12.23.12",
    "next": "^15.5.27",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.6",
    "prisma": "^6.13.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.2",
      "next>postcss": "^8.5.28",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
      "brace-expansion@>=3.0.0 <3.0.8": "3.0.8",
      "source-map-js@<1.2.2": "1.2.2",
      "sharp": "^0.35.5",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12"
    }
  }
}
