generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Persistence (schema doc §5) ───────────────────────────────────

model IntentSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?
  pill            String
  audienceDerived String?
  said            Json      @default("{}")
  inferred        Json      @default("{}")
  consent         Json      @default("{}")
  recommendation  Json      @default("{}")
  journeyMap      Json      @default("[]")
  conversionState String    @default("started")
  retention       Json      @default("{}")
  expiresAt       DateTime
  leadId          String?   @unique @db.Uuid
  lead            Lead?     @relation(fields: [leadId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([conversionState, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("intent_sessions")
}

model Lead {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact         Json
  consent         Json
  audience        String?
  intentTag       String?
  interestItemIds String[]       @default([])
  sourceJourney   String
  captureLayer    String
  sessionRef      String?
  qualification   String         @default("unqualified")
  owner           String?
  status          String         @default("new")
  aiOutputRef     Json?
  retention       Json           @default("{}")
  expiresAt       DateTime
  session         IntentSession?
  followUps       LeadFollowUp[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([owner, status, updatedAt(sort: Desc)])
  @@index([intentTag, createdAt(sort: Desc)])
  @@map("leads")
}

model LeadFollowUp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  at        DateTime
  channel   String
  note      String
  by        String
  createdAt DateTime @default(now())

  @@index([leadId, at(sort: Desc)])
  @@map("lead_follow_ups")
}

model Feedback {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionRef String
  helpful    Boolean
  note       String?
  retention  Json     @default("{}")
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([helpful, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("feedback")
}

model AiUsage {
  date             DateTime @id @db.Date
  classifyCalls    Int      @default(0)
  rankCalls        Int      @default(0)
  rejectedOutputs  Int      @default(0)
  estimatedCostUsd Decimal  @default(0) @db.Decimal(12, 4)
  hourBuckets      Json     @default("{}")

  @@map("ai_usage")
}

// ── Catalogue / taxonomy (seed relational core) ───────────────────

model TaxonomyTerm {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind  String
  slug  String
  label String

  @@unique([kind, slug])
  @@map("taxonomy_terms")
}

model CatalogueItem {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId               String                   @unique
  type                 String
  name                 String
  slug                 String                   @unique
  shortDescription     String
  domain               String
  level                String?
  durationHours        Float?
  deliveryModes        String[]                 @default([])
  trackMapping         String?
  pricingMode          String
  priceInrPerHour      Float?
  priceBasis           String?
  evidenceSource       String
  status               String
  needsEditorialReview Boolean                  @default(false)
  sourcePath           String?
  audiences            CatalogueItemAudience[]
  intents              CatalogueItemIntent[]
  themes               CatalogueItemTheme[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([type, status])
  @@index([domain])
  @@map("catalogue_items")
}

model CatalogueItemAudience {
  itemId String         @db.Uuid
  tag    String
  item   CatalogueItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, tag])
  @@map("catalogue_item_audiences")
}

model CatalogueItemIntent {
  itemId String        @db.Uuid
  tag    String
  item   CatalogueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, tag])
  @@map("catalogue_item_intents")
}

model CatalogueItemTheme {
  itemId String        @db.Uuid
  tag    String
  item   CatalogueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, tag])
  @@map("catalogue_item_themes")
}

model JourneyRule {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId      String  @unique
  intentTag   String
  trackItemId String?
  audience    String?
  theme       String?
  templateRef String?

  @@index([intentTag])
  @@map("journey_rules")
}

model StaffRole {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug  String @unique
  label String

  @@map("staff_roles")
}

model StaffUser {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @unique
  name  String
  role  String

  @@map("staff_users")
}

model Meta {
  key   String @id
  value Json

  @@map("meta")
}
